{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Darkwave",
  "version": "0.1.0",
  "identifier": "dev.darkwave.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Darkwave",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/similarity-worker"],
    "macOS": {
      "entitlements": "entitlements.mas.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installMode": "perMachine"
      }
    }
  }
}
