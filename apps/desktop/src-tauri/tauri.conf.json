{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Darkwave",
  "version": "0.3.1",
  "identifier": "dev.darkwave.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Darkwave",
        "width": 1480,
        "height": 900,
        "minWidth": 920,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost; media-src 'self' asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["darkwave"],
        "name": "Darkwave Library",
        "description": "Darkwave Library",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "dev.darkwave.library",
          "conformsTo": ["public.database", "public.data"]
        }
      },
      {
        "ext": ["darkwavebak"],
        "name": "Darkwave Library Backup",
        "description": "Darkwave Library Backup",
        "role": "Viewer",
        "rank": "Owner",
        "exportedType": {
          "identifier": "dev.darkwave.library-backup",
          "conformsTo": ["public.data"]
        }
      }
    ],
    "externalBin": ["binaries/similarity-worker"],
    "resources": {
      "models/*": "models/",
      "icons/document-darkwave.icns": "document-darkwave.icns",
      "icons/document-darkwave-backup.icns": "document-darkwave-backup.icns"
    },
    "macOS": {
      "entitlements": "entitlements.mas.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installMode": "perMachine"
      }
    }
  }
}
