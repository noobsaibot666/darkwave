<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for any Mac App Store submission. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Without this, the sandbox blocks Tauri's frontend<->backend IPC
         (it's treated as outbound networking even though nothing leaves
         the machine) — the webview never receives anything to render,
         producing a permanently blank window. Not needed for actual
         internet access; Darkwave has none in the MAS build. See
         https://github.com/tauri-apps/tauri-docs/issues/3171. -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Darkwave has the user explicitly pick each library's source folder
         (Tauri dialog plugin) rather than scanning arbitrary paths, so this
         plus the bookmark entitlement below is the whole sandboxed
         file-access story: grant access to what was picked, remember it
         across launches via a security-scoped bookmark (implemented —
         see src/security_scoped_bookmark.rs). -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>

    <key>com.apple.developer.team-identifier</key>
    <string>RD7UU4Z3D2</string>
    <key>com.apple.application-identifier</key>
    <string>RD7UU4Z3D2.dev.darkwave.app</string>
</dict>
</plist>
